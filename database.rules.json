{
  "rules": {
    "deviceSecrets": {
      "$deviceId": {
        ".read": false,
        ".write": false
      }
    },
    "claimRequests": {
      "$deviceId": {
        ".read": "auth != null && data.child('uid').val() === auth.uid",
        ".write": "auth != null && !root.child('devices').child($deviceId).child('ownerId').exists() && (!data.exists() || data.child('uid').val() === auth.uid) && newData.child('pin').isString() && newData.child('pin').val() === root.child('deviceSecrets').child($deviceId).child('setupPin').val() && newData.child('uid').val() === auth.uid"
      }
    },
    "devices": {
      ".indexOn": ["ownerId"],
      "$deviceId": {
        ".read": "auth != null && (data.child('ownerId').val() === auth.uid || data.child('deviceAuthUid').val() === auth.uid)",
        "ownerId": {
          ".write": "auth != null && data.val() == null && root.child('claimRequests').child($deviceId).child('uid').val() === auth.uid && newData.val() === auth.uid"
        },
        "deviceAuthUid": {
          ".write": false
        },
        "status": {
          ".write": "auth != null && root.child('devices').child($deviceId).child('deviceAuthUid').val() === auth.uid"
        },
        "lastHeartbeat": {
          ".write": "auth != null && root.child('devices').child($deviceId).child('deviceAuthUid').val() === auth.uid"
        },
        "state": {
          ".write": "auth != null && root.child('devices').child($deviceId).child('deviceAuthUid').val() === auth.uid",
          "feedWeightGrams": { ".validate": "newData.isNumber()" },
          "targetFeedGrams": { ".validate": "newData.isNumber()" },
          "hopperLevelPercent": { ".validate": "newData.isNumber()" },
          "waterLow": { ".validate": "newData.isBoolean()" },
          "waterHigh": { ".validate": "newData.isBoolean()" },
          "pumpActive": { ".validate": "newData.isBoolean()" },
          "feedingActive": { ".validate": "newData.isBoolean()" },
          "emergencyStopActive": { ".validate": "newData.isBoolean()" },
          "timestamp": { ".validate": "newData.isNumber()" }
        }
      }
    },
    "systemData": {
      "$deviceId": {
        ".indexOn": ["timestamp"],
        ".read": "auth != null && root.child('devices').child($deviceId).child('ownerId').val() === auth.uid",
        "$pushId": {
           ".write": "auth != null && root.child('devices').child($deviceId).child('deviceAuthUid').val() === auth.uid"
        }
      }
    },
    "commands": {
      "$deviceId": {
        ".read": "auth != null && (root.child('devices').child($deviceId).child('ownerId').val() === auth.uid || root.child('devices').child($deviceId).child('deviceAuthUid').val() === auth.uid)",
        "$commandId": {
          ".write": "auth != null && root.child('devices').child($deviceId).child('ownerId').val() === auth.uid && !data.exists()",
          ".validate": "newData.hasChildren(['commandId', 'command', 'issuedBy', 'createdAt', 'status'])",
          "commandId": {
            ".validate": "newData.isString() && newData.val() === $commandId"
          },
          "command": {
            ".validate": "newData.isString() && (newData.val() === 'MANUAL_FEED' || newData.val() === 'ESTOP_RELEASE' || newData.val() === 'SYSTEM_RESTART' || newData.val() === 'STATUS_REQ')"
          },
          "issuedBy": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "status": {
            ".write": "auth != null && root.child('devices').child($deviceId).child('deviceAuthUid').val() === auth.uid",
            ".validate": "
              (!data.exists() && newData.val() === 'queued') ||
              (data.exists() && (
                (data.val() === 'queued' && newData.val() === 'acknowledged') ||
                (data.val() === 'acknowledged' && (newData.val() === 'executing' || newData.val() === 'failed')) ||
                (data.val() === 'executing' && (newData.val() === 'completed' || newData.val() === 'failed'))
              ))
            "
          },
          "acknowledgedAt": {
            ".write": "auth != null && root.child('devices').child($deviceId).child('deviceAuthUid').val() === auth.uid",
            ".validate": "newData.isNumber()"
          },
          "completedAt": {
            ".write": "auth != null && root.child('devices').child($deviceId).child('deviceAuthUid').val() === auth.uid",
            ".validate": "newData.isNumber()"
          },
          "error": {
            ".write": "auth != null && root.child('devices').child($deviceId).child('deviceAuthUid').val() === auth.uid",
            ".validate": "newData.isString()"
          }
        }
      }
    },
    "alerts": {
      "$deviceId": {
        ".indexOn": ["timestamp"],
        ".read": "auth != null && root.child('devices').child($deviceId).child('ownerId').val() === auth.uid",
        "$pushId": {
           ".write": "auth != null && root.child('devices').child($deviceId).child('deviceAuthUid').val() === auth.uid"
        }
      }
    }
  }
}
